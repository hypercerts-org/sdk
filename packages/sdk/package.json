{
  "name": "@hypercerts-org/sdk",
  "version": "0.0.0",
  "description": "TypeScript SDK for reading and writing Hypercerts records on the AT Protocol.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hypercerts-org/sdk.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./activity": {
      "types": "./dist/activity/index.d.ts",
      "default": "./dist/activity/index.js"
    },
    "./blob": {
      "types": "./dist/blob/index.d.ts",
      "default": "./dist/blob/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/test-utils"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@atproto/lex": "^0.4.4",
    "@hypercerts-org/lexicon": "^2.0.1"
  },
  "devDependencies": {
    "@atproto/lex": "0.4.4",
    "@hypercerts-org/lexicon": "2.0.1"
  },
  "dependencies": {
    "@atproto-labs/did-resolver": "0.3.11",
    "@atproto/lex-cbor": "0.1.7"
  }
}
