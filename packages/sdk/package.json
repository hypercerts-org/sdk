{
  "name": "@hypercerts-org/sdk",
  "version": "0.0.0",
  "description": "TypeScript SDK for reading and writing Hypercerts records on the AT Protocol.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hypercerts-org/sdk.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./activity": {
      "types": "./dist/activity/index.d.ts",
      "default": "./dist/activity/index.js"
    },
    "./actor": {
      "types": "./dist/actor/index.d.ts",
      "default": "./dist/actor/index.js"
    },
    "./blob": {
      "types": "./dist/blob/index.d.ts",
      "default": "./dist/blob/index.js"
    },
    "./collection": {
      "types": "./dist/collection/index.d.ts",
      "default": "./dist/collection/index.js"
    },
    "./feature": {
      "types": "./dist/feature/index.d.ts",
      "default": "./dist/feature/index.js"
    },
    "./location": {
      "types": "./dist/location/index.d.ts",
      "default": "./dist/location/index.js"
    },
    "./organization": {
      "types": "./dist/organization/index.d.ts",
      "default": "./dist/organization/index.js"
    },
    "./social": {
      "types": "./dist/social/index.d.ts",
      "default": "./dist/social/index.js"
    },
    "./tag": {
      "types": "./dist/tag/index.d.ts",
      "default": "./dist/tag/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/test-utils"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "peerDependencies": {
    "@atproto/lex": "^0.4.4",
    "@hypercerts-org/lexicon": "^2.0.1"
  },
  "devDependencies": {
    "@atproto/lex": "0.4.4",
    "@hypercerts-org/lexicon": "2.0.1"
  },
  "dependencies": {
    "@atproto-labs/did-resolver": "0.3.11",
    "@atproto/lex-cbor": "0.1.7"
  }
}
