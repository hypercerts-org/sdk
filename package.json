{
  "name": "hypercerts-sdk-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check:package": "pnpm build && node scripts/check-package.mjs",
    "check:duplicates": "jscpd --similarity --ignore-identifiers --ignore-literals --max-gap-lines 3 --ignore \"**/*.test.ts,**/test-utils/**,packages/sdk/src/*/index.ts\" --pattern \"{packages/sdk/src,scripts}/**\" --exit-code 1 .",
    "check:duplicates:semantic": "jscpd --semantic --semantic-download --kind semantic --semantic-same-threshold 0.55 --ignore \"**/*.test.ts,**/test-utils/**,packages/sdk/src/*/index.ts\" --pattern \"{packages/sdk/src,scripts}/**\" --exit-code 1 .",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.2",
    "jscpd": "5.4.2",
    "lefthook": "2.2.2",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
